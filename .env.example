# Discord
DISCORD_TOKEN=

# Server / role / channel IDs (right-click in Discord with Developer Mode on → Copy ID)
GUILD_ID=
MOD_LOG_CHANNEL_ID=
FORTY_PLUS_ROLE_ID=    # the "40+" role
MODERATOR_ROLE_ID=     # the "mods" role
ADMIN_ROLE_ID=         # the "admins" role (inherits mod privileges)

# Defaults
TIMEZONE=America/Los_Angeles
LOG_LEVEL=INFO

# Reddit bridge (optional — set both to enable cogs.reddit_sync, leave blank to disable)
# A Devvit app on r/FriendsOver40 posts modlog/verification events to a Discord
# webhook in a dedicated bridge channel. The bot listens for those webhook
# messages and acts on them. See reddit_devvit/ for the Devvit app.
BRIDGE_CHANNEL_ID=       # ID of the #reddit-bridge channel (mods-only)
BRIDGE_WEBHOOK_ID=       # ID of the webhook posting into that channel
