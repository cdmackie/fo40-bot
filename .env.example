# Discord
DISCORD_TOKEN=

# Server / role / channel IDs (right-click in Discord with Developer Mode on → Copy ID)
GUILD_ID=
MOD_LOG_CHANNEL_ID=
FORTY_PLUS_ROLE_ID=    # the "40+" role
MODERATOR_ROLE_ID=     # the "mods" role
ADMIN_ROLE_ID=         # the "admins" role (inherits mod privileges)

# Defaults
TIMEZONE=America/Los_Angeles
LOG_LEVEL=INFO

# Reddit bridge (ban relay) — Devvit app posts ban events to a Discord
# webhook in a dedicated bridge channel; the bot reads them.
BRIDGE_CHANNEL_ID=       # ID of the #reddit-bridge channel (mods-only)
BRIDGE_WEBHOOK_ID=       # ID of the webhook posting into that channel

# Invite-link flow — pinned Devvit post on r/FriendsOver40 has a "Join
# Discord" button. Button signs an HMAC token containing the user's Reddit
# username and redirects them to BOT_PUBLIC_URL/join?token=...; the bot
# verifies the token, creates a one-time Discord invite, redirects to
# discord.gg, then auto-links and roles them on join.
BRIDGE_SIGNING_SECRET=   # shared HMAC secret with the Devvit app's signing_secret setting
BOT_PUBLIC_URL=          # publicly-reachable URL of the bot's web server (e.g. https://fo40.example.com)
WEB_SERVER_PORT=8080     # local port the bot's web server listens on
INVITE_CHANNEL_ID=       # ID of the channel new members join into (the bot creates one-time invites for it)
